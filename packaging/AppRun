#!/bin/sh
set -eu
APPDIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
INTERNAL="$APPDIR/usr/FISH-Analysis/_internal"
if [ -f "$INTERNAL/runtime-cache.json" ]; then
    case "${1-}" in
        --*|-m) progress="" ;;
        *) progress="--progress" ;;
    esac
    FISH_RUNTIME_CACHE="$("$APPDIR/usr/FISH-Analysis/FISH-Analysis" --prepare-runtime $progress)"
    export FISH_RUNTIME_CACHE
    for lib in "$FISH_RUNTIME_CACHE"/nvidia/*/lib "$FISH_RUNTIME_CACHE"/nvidia/*/nvvm/lib64 "$FISH_RUNTIME_CACHE"/torch/lib "$FISH_RUNTIME_CACHE"; do
        if [ -d "$lib" ]; then
            LD_LIBRARY_PATH="$lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
        fi
    done
fi
# The dynamic loader must see bundled pip CUDA libraries before Python starts.
for lib in "$INTERNAL"/nvidia/*/lib; do
    if [ -d "$lib" ]; then
        LD_LIBRARY_PATH="$lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
    fi
done
if [ -d "$INTERNAL/nvidia" ]; then
    export LD_LIBRARY_PATH
    export FISH_CUDA_PATH_READY=1
    PATH="$INTERNAL/nvidia/cuda_nvcc/bin:$PATH"
    export PATH
    XLA_FLAGS="${XLA_FLAGS:+$XLA_FLAGS }--xla_gpu_cuda_data_dir=\"$INTERNAL/nvidia/cuda_nvcc\""
    export XLA_FLAGS
fi
exec "$APPDIR/usr/FISH-Analysis/FISH-Analysis" "$@"
