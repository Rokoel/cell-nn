{
  "version": 1,
  "engine": "stardist3d",
  "config": {
    "voxel_um": 0.3,
    "min_diameter_um": 2.5,
    "max_diameter_um": 32,
    "min_sphericity": 0.62,
    "max_elongation": 1.8,
    "exclude_border": false,
    "epochs": 150,
    "steps_per_epoch": 200,
    "batch_size": 1,
    "patch_z": 80,
    "patch_xy": 80,
    "rays": 64,
    "filters": 16,
    "learning_rate": 0.0003,
    "patience": 20,
    "validate_every": 15,
    "probability_threshold": 0.35,
    "nms_threshold": 0.4,
    "seed": 42,
    "device": "gpu",
    "calibrate_probability": true,
    "native_sampling": true,
    "overlap_policy": "isolate",
    "streaming_validation": true,
    "validation_images": 8
  },
  "checkpoint": "best.weights.h5",
  "supervision": "Sparse manual objects; unknown=-1; reviewed background=0",
  "runtime": {
    "device": "GPU",
    "devices": [
      "PhysicalDevice(name='/physical_device:GPU:0', device_type='GPU')"
    ],
    "versions": {
      "stardist": "0.9.2",
      "tensorflow": "2.21.0",
      "keras": "3.15.1",
      "numpy": "2.5.3",
      "scipy": "1.18.1"
    }
  },
  "calibration": "Maximum complete-reference Dice on validation acquisitions; unknown objects unscored."
}