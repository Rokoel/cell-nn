{
  "version": 1,
  "engine": "stardist3d",
  "config": {
    "voxel_um": 0.3,
    "min_diameter_um": 2.5,
    "max_diameter_um": 32,
    "min_sphericity": 0.72,
    "max_elongation": 1.5,
    "exclude_border": true,
    "epochs": 120,
    "steps_per_epoch": 200,
    "batch_size": 1,
    "patch_z": 48,
    "patch_xy": 48,
    "rays": 64,
    "filters": 16,
    "learning_rate": 0.0003,
    "patience": 20,
    "validate_every": 10,
    "probability_threshold": 0.75,
    "nms_threshold": 0.15,
    "seed": 42,
    "device": "gpu",
    "calibrate_probability": false,
    "native_sampling": true,
    "overlap_policy": "isolate",
    "streaming_validation": true,
    "validation_images": 8,
    "precision_mode": true,
    "precision_max_diameter_um": 10,
    "membrane_support": 0.65,
    "membrane_contrast": 0.05,
    "membrane_intensity": 0.12,
    "curate_training_shapes": true,
    "synthetic_background_fraction": 0.25
  },
  "checkpoint": "best.weights.h5",
  "supervision": "Sparse manual objects; unknown=-1; reviewed background=0",
  "runtime": {
    "device": "GPU",
    "devices": [
      "PhysicalDevice(name='/physical_device:GPU:0', device_type='GPU')"
    ],
    "versions": {
      "stardist": "0.9.2",
      "tensorflow": "2.21.0",
      "keras": "3.15.1",
      "numpy": "2.5.3",
      "scipy": "1.18.1"
    }
  }
}